{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "code-memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@uworx/code-memory"
      ]
    }
  }
}
