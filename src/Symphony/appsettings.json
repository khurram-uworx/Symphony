{
  "Database": {
    // sqlite (default) | sqlserver | postgresql
    // postgresql aliases: postgres, npgsql
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/symphony.db"
    // SqlServer is required when Database:Provider is sqlserver.
    // Example: Server=localhost;Database=symphony;Trusted_Connection=True;TrustServerCertificate=True
    // Env: ConnectionStrings__SqlServer
    //
    // PostgreSQL is required when Database:Provider is postgresql, postgres, or npgsql.
    // Npgsql is accepted as an alias key when PostgreSQL is not set.
    // Example: Host=localhost;Database=symphony;Username=symphony;Password=change-me
    // Env: ConnectionStrings__PostgreSQL
  },
  "SeedAdmin": {
    "UserName": "testadmin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
