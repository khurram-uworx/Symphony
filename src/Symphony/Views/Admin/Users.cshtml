@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@model IEnumerable<IdentityUser>
@{
    ViewData["Title"] = "Users";
}
<section class="panel">
    <div class="users-header">
        <h1>Users</h1>
        <button type="button" class="primary-button" id="open-create-user">Create user</button>
    </div>

    @if (TempData["Message"] is string message)
    {
        <p class="muted">@message</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="validation">@error</p>
    }

    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Roles</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            var roles = await UserManager.GetRolesAsync(user);
            var role = roles.FirstOrDefault() ?? "User";
            var isLocked = user.LockoutEnd is not null && user.LockoutEnd > DateTimeOffset.UtcNow;
            <tr class="user-row" data-user-id="@user.Id" data-user-name="@user.UserName" data-user-role="@role" onclick="openManageUser(this)">
                <td>@user.UserName</td>
                <td>@string.Join(", ", roles)</td>
                <td>@(isLocked ? "Locked" : "Active")</td>
            </tr>
        }
        </tbody>
    </table>

    <dialog id="create-user-dialog">
        <h2>Create user</h2>
        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()
            <label>
                Username
                <input name="userName" autocomplete="username" required />
            </label>
            <label>
                Password
                <input name="password" type="password" autocomplete="new-password" required />
            </label>
            <label>
                Role
                <select name="role">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>
            </label>
            <div class="dialog-actions">
                <button type="submit">Create user</button>
                <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
            </div>
        </form>
    </dialog>

    <dialog id="manage-user-dialog">
        <h2 id="manage-user-name">Manage user</h2>

        <h3>Role</h3>
        <form asp-action="ChangeRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" class="manage-user-id" />
            <label>
                Role
                <select name="role" id="manage-user-role">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>
            </label>
            <button type="submit">Change role</button>
        </form>

        <h3>Status</h3>
        <div class="dialog-actions">
            <form asp-action="EnableUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" class="manage-user-id" />
                <button type="submit">Enable user</button>
            </form>
            <form asp-action="DisableUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" class="manage-user-id" />
                <button type="submit">Disable user</button>
            </form>
        </div>

        <h3>Password</h3>
        <form asp-action="SetUserPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" class="manage-user-id" />
            <label>
                New password
                <input name="password" type="password" autocomplete="new-password" required />
            </label>
            <button type="submit">Change password</button>
        </form>

        <h3>Delete</h3>
        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this user?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" class="manage-user-id" />
            <button type="submit" class="danger">Delete user</button>
        </form>

        <div class="dialog-actions">
            <button type="button" onclick="this.closest('dialog').close()">Close</button>
        </div>
    </dialog>
</section>

<script>
    function openCreateUserDialog() {
        const manageDialog = document.getElementById('manage-user-dialog');
        if (manageDialog?.open) {
            manageDialog.close();
        }
        document.getElementById('create-user-dialog').showModal();
    }

    function openManageUser(row) {
        const createDialog = document.getElementById('create-user-dialog');
        if (createDialog?.open) {
            createDialog.close();
        }

        const id = row.getAttribute('data-user-id');
        const name = row.getAttribute('data-user-name');
        const role = row.getAttribute('data-user-role');

        document.getElementById('manage-user-name').textContent = name || 'Manage user';
        document.querySelectorAll('.manage-user-id').forEach(function (input) {
            input.value = id;
        });

        const roleSelect = document.getElementById('manage-user-role');
        if (roleSelect) {
            roleSelect.value = role || 'User';
        }

        document.getElementById('manage-user-dialog').showModal();
    }

    document.getElementById('open-create-user').addEventListener('click', openCreateUserDialog);

    document.querySelectorAll('.user-row').forEach(function (row) {
        row.style.cursor = 'pointer';
    });
</script>