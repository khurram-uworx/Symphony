@model Symphony.Controllers.LoginInput
@{
    ViewData["Title"] = "Sign in";
}
<section class="panel">
    <h1>Sign in</h1>
    <p class="muted">Use the admin credentials from the host's first start.</p>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <label>
            Username
            <input asp-for="UserName" autocomplete="username" />
        </label>
        <span asp-validation-for="UserName" class="field-error"></span>
        <label>
            Password
            <input asp-for="Password" autocomplete="current-password" />
        </label>
        <span asp-validation-for="Password" class="field-error"></span>
        <button type="submit">Sign in</button>
    </form>
</section>
