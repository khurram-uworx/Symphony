@model Symphony.Controllers.ChangePasswordInput
@{
    ViewData["Title"] = "Manage";
    var displayName = User.Identity?.Name;
}
<section class="panel">
    <h1>Manage</h1>
    <p class="muted">Hello, @displayName</p>

    @if (TempData["Message"] is string message)
    {
        <p class="muted">@message</p>
    }

    <h2>Change password</h2>
    <form asp-action="Manage" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation" role="alert"></div>

        <label>
            Current password
            <input asp-for="CurrentPassword" autocomplete="current-password" />
        </label>
        <span asp-validation-for="CurrentPassword" class="field-error"></span>

        <label>
            New password
            <input asp-for="NewPassword" autocomplete="new-password" />
        </label>
        <span asp-validation-for="NewPassword" class="field-error"></span>

        <label>
            Confirm new password
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
        </label>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <button type="submit">Change password</button>
    </form>

    <h2>Sign out</h2>
    <form asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit">Log out</button>
    </form>
</section>