    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.26" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.25.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
