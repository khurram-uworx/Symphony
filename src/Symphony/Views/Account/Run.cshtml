@{
    ViewData["Title"] = "Run launcher";
    var defaultWorkflowName = ViewData["DefaultWorkflowName"] as string ?? "";
    var workSourceConfigured = ViewData["WorkSourceConfigured"] is true;
    var githubTokenConfigured = ViewData["GitHubTokenConfigured"] is true;
}
<style>
    .work-items-builder { margin: 1rem 0; }
    .work-item-row { display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .work-item-row label { flex: 1 1 12rem; }
    .work-item-list { list-style: none; padding: 0; margin: 0.5rem 0; }
    .work-item-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
    .work-item-list li > div { flex: 1 1 auto; }
</style>
<section class="panel">
    <h1>Run launcher</h1>
    <p class="muted">Submit work to the same API used by integrations.</p>

    <div class="run-tabs" role="tablist">
        <button type="button" class="run-tab is-active" data-tab="run" role="tab" aria-selected="true">Launch work</button>
        <button type="button" class="run-tab" data-tab="api" role="tab" aria-selected="false">Curl example</button>
    </div>

    <div id="run-tab-run" class="run-panel">
        <div id="run-status" class="validation" role="status" aria-live="polite"></div>
        <form id="run-form">
            @Html.AntiForgeryToken()
            <label>
                External ID (optional)
                <input id="run-external-id" autocomplete="off" />
            </label>

            @if (workSourceConfigured)
            {
                <label>
                    Ticket IDs (comma or newline separated)
                    <textarea id="run-ticket-ids" rows="3" placeholder="ENG-1, ENG-2"></textarea>
                </label>
            }
            else
            {
                <p class="muted">Work source is not yet configured.</p>
            }

            <div class="work-items-builder">
                <p class="muted">Work items (optional)</p>
                <div class="work-item-row">
                    <label>
                        Title
                        <input id="run-work-item-title" autocomplete="off" placeholder="Work item title" />
                    </label>
                    <label>
                        Id (optional)
                        <input id="run-work-item-id" autocomplete="off" placeholder="auto-generated if blank" />
                    </label>
                    <label>
                        Description (optional)
                        <textarea id="run-work-item-description" rows="2" placeholder="Details, context, or acceptance criteria"></textarea>
                    </label>
                    <button type="button" id="run-add-work-item">Add work item</button>
                </div>
                <ul id="run-work-item-list" class="work-item-list"></ul>
            </div>

            @if (githubTokenConfigured)
            {
                <label>
                    GitHub repository
                    <input id="run-repository" autocomplete="off" placeholder="owner/repo" />
                </label>
            }
            else
            {
                <p class="muted">GitHub personal access token is not yet configured.</p>
            }

            <label>
                Workflow
                <select id="run-workflow">
                    <option value="">(loading...)</option>
                </select>
            </label>

            <label>
                Overrides (optional JSON object)
                <textarea id="run-overrides" rows="3" placeholder="{}"></textarea>
            </label>

            <button type="submit" id="run-submit">Submit work</button>
        </form>
        <div id="run-result" hidden></div>
    </div>

    <div id="run-tab-api" class="run-panel" hidden>
        <p class="muted">Replay the same request from a terminal using an API key or a signed-in session.</p>
        <p>
            <a href="/Account/ApiKeys">Manage API keys</a> — keys are system-generated and shown once. Authenticate with
            <code>Authorization: Bearer &lt;YOUR_API_KEY&gt;</code> (or the <code>X-API-Key</code> header).
        </p>
        <pre><code id="run-curl">curl -X POST "http://localhost:5080/api/work" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer &lt;YOUR_API_KEY&gt;" \
  --data '{
    "externalId": null,
    "ticketIds": ["ENG-1"],
    "workItems": [],
    "github": {
      "repository": "owner/repo"
    },
    "workflowName": "WORKFLOW",
    "overrides": {}
  }'</code></pre>
        <p class="muted">
            Replace <code>&lt;YOUR_API_KEY&gt;</code> with a key from the API Keys page. Keys are stored hashed and can be
            disabled, rotated, or revoked at any time; disabling a user immediately invalidates all their keys.
            GitHub tokens are never embedded in this page. If you do not have a workflow yet, create one on the
            Workflows page.
        </p>
    </div>
</section>

<script>
    window.defaultWorkflowName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultWorkflowName));
</script>
<script>
(function () {
    const tabs = document.querySelectorAll('.run-tab');
    const panels = {
        run: document.getElementById('run-tab-run'),
        api: document.getElementById('run-tab-api')
    };

    function activateTab(name) {
        Object.keys(panels).forEach(function (key) {
            panels[key].hidden = key !== name;
        });
        tabs.forEach(function (tab) {
            const active = tab.getAttribute('data-tab') === name;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            activateTab(tab.getAttribute('data-tab'));
        });
    });

    function setStatus(message, isError) {
        const status = document.getElementById('run-status');
        status.textContent = message || '';
        status.classList.toggle('is-error', !!isError);
        status.classList.toggle('is-success', !isError && !!message);
    }

    function parseList(text) {
        return text.split(/[\r\n,]+/).map(function (item) {
            return item.trim();
        }).filter(function (item) {
            return item.length > 0;
        });
    }

    const workflowSelect = document.getElementById('run-workflow');
    const queuedWorkItems = [];
    const workItemList = document.getElementById('run-work-item-list');
    function renderWorkItems() {
        workItemList.innerHTML = '';
        queuedWorkItems.forEach(function (item, index) {
            const row = document.createElement('li');
            row.className = 'work-item-row';

            const details = document.createElement('div');
            const title = document.createElement('strong');
            title.textContent = item.title;
            details.appendChild(title);
            if (item.id) {
                const id = document.createElement('span');
                id.className = 'muted';
                id.textContent = ' (' + item.id + ')';
                details.appendChild(id);
            }
            if (item.description) {
                const description = document.createElement('p');
                description.className = 'muted';
                description.textContent = item.description;
                details.appendChild(description);
            }

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.textContent = 'Remove';
            removeButton.addEventListener('click', function () {
                queuedWorkItems.splice(index, 1);
                renderWorkItems();
            });

            row.appendChild(details);
            row.appendChild(removeButton);
            workItemList.appendChild(row);
        });
    }

    function addWorkItem() {
        const titleInput = document.getElementById('run-work-item-title');
        const idInput = document.getElementById('run-work-item-id');
        const descriptionInput = document.getElementById('run-work-item-description');
        const title = (titleInput.value || '').trim();
        if (!title) {
            setStatus('Work item title is required.', true);
            titleInput.focus();
            return;
        }

        const item = { title: title };
        const id = (idInput.value || '').trim();
        if (id) item.id = id;
        const description = (descriptionInput.value || '').trim();
        if (description) item.description = description;
        queuedWorkItems.push(item);
        renderWorkItems();

        titleInput.value = '';
        idInput.value = '';
        descriptionInput.value = '';
        titleInput.focus();
        setStatus('', false);
    }

    document.getElementById('run-add-work-item').addEventListener('click', addWorkItem);
    async function loadWorkflows() {
        workflowSelect.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '(select a workflow)';
        workflowSelect.appendChild(placeholder);

        try {
            const response = await fetch('/api/workflows', { credentials: 'same-origin' });
            if (!response.ok) {
                setStatus('Unable to load workflows.', true);
                return;
            }

            const workflows = await response.json();
            workflows.sort(function (a, b) {
                return String(a.name).localeCompare(String(b.name));
            });

            let selected = window.defaultWorkflowName || '';
            workflows.forEach(function (item) {
                const option = document.createElement('option');
                option.value = item.name;
                option.textContent = item.name + (item.isDefault ? ' (default)' : '');
                if (item.isDefault && !selected) {
                    selected = item.name;
                }
                workflowSelect.appendChild(option);
            });

            if (selected && Array.prototype.some.call(workflowSelect.options, function (option) { return option.value === selected; })) {
                workflowSelect.value = selected;
            } else if (workflowSelect.options.length > 1) {
                workflowSelect.value = workflowSelect.options[1].value;
            }
        } catch (error) {
            setStatus('Unable to load workflows.', true);
        }
    }

    document.getElementById('run-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        setStatus('', false);

        const result = document.getElementById('run-result');
        result.hidden = true;
        result.innerHTML = '';

        const repositoryInput = document.getElementById('run-repository');
        const patInput = document.getElementById('run-pat');
        const ticketIdsInput = document.getElementById('run-ticket-ids');
        const repository = repositoryInput ? repositoryInput.value.trim() : '';
        const token = patInput ? patInput.value : '';
        const workflowName = workflowSelect.value.trim();
        const ticketIds = ticketIdsInput ? parseList(ticketIdsInput.value) : [];
        const externalId = document.getElementById('run-external-id').value.trim();

        const workItems = queuedWorkItems.slice();

        let overrides = {};
        const overridesText = document.getElementById('run-overrides').value.trim();
        if (overridesText) {
            try {
                const parsed = JSON.parse(overridesText);
                if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
                    throw new Error('Overrides must be a JSON object.');
                }
                overrides = parsed;
            } catch (error) {
                setStatus(error.message, true);
                return;
            }
        }

        const payload = {
            externalId: externalId || null,
            ticketIds: ticketIds,
            workItems: workItems,
            github: {
                repository: repository,
                personalAccessToken: token
            },
            workflowName: workflowName,
            overrides: overrides
        };

        const submitButton = document.getElementById('run-submit');
        submitButton.disabled = true;
        try {
            const response = await fetch('/api/work', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            let body = {};
            try {
                body = await response.json();
            } catch (_) {
                body = {};
            }

            if (!response.ok) {
                setStatus((body && (body.error || body.message || body.title)) || ('Request failed: ' + response.status), true);
                return;
            }

            result.hidden = false;
            const jobId = body.jobId;
            const statusUrl = body.statusUrl;
            result.replaceChildren();
            const paragraph = document.createElement('p');
            paragraph.className = 'muted';
            paragraph.appendChild(document.createTextNode('Job queued: '));
            const strong = document.createElement('strong');
            strong.textContent = jobId;
            paragraph.appendChild(strong);
            const linkParagraph = document.createElement('p');
            const link = document.createElement('a');
            link.href = statusUrl;
            link.textContent = 'Open job status';
            linkParagraph.appendChild(link);
            result.appendChild(paragraph);
            result.appendChild(linkParagraph);
            setStatus('Work submitted successfully.', false);
        } catch (error) {
            setStatus(error.message, true);
        } finally {
            submitButton.disabled = false;
        }
    });

    loadWorkflows();
})();
</script>
