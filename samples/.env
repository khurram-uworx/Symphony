# Sample-only defaults for the published-image compose stack.
# Change every credential and secret before using this outside local evaluation.

POSTGRES_USER=symphony
POSTGRES_PASSWORD=symphony
POSTGRES_DB=symphony

# Database provider and connection string (must match Database registration).
Database__Provider=postgresql
ConnectionStrings__PostgreSQL=Host=postgres;Port=5432;Database=symphony;Username=symphony;Password=symphony

# First admin username (password is generated and printed once to container logs).
SeedAdmin__UserName=testadmin

# Published image. Override to pin a version, e.g. ghcr.io/khurram-uworx/symphony:1.2.3
SYMPHONY_IMAGE=ghcr.io/khurram-uworx/symphony:latest
