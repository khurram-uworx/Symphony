@using Symphony.Data
@using Symphony.Dto
@model ConfigurationDto
@{
    ViewData["Title"] = "Account";
    var displayName = ViewData["DisplayName"] as string ?? User.Identity?.Name;
    var roles = (ViewData["Roles"] as IEnumerable<string>) ?? Array.Empty<string>();
    var apiKeys = (ViewData["ApiKeys"] as IReadOnlyList<ApiKey>) ?? Array.Empty<ApiKey>();
    var activeTab = (ViewData["ActiveTab"] as string) ?? "jobs";
    var workflowTemplate = (ViewData["WorkflowTemplate"] as string) ?? "";
    var newKey = ViewData["NewApiKey"] as string;
    var newKeyName = ViewData["NewApiKeyName"] as string;
}
<style>
    #job-details-dialog { width: min(46rem, 92vw); }
    .job-details-grid { display: grid; grid-template-columns: minmax(8rem, 10rem) 1fr; gap: 0.35rem 1rem; margin: 0.75rem 0; }
    .job-details-grid dt { font-weight: 600; }
    .job-details-grid dd { margin: 0; }
</style>
<section class="panel">
    <div class="account-header">
        <h1>Account</h1>
        <div class="account-shortcuts">
            <a class="primary-button" asp-controller="Account" asp-action="Manage">Manage (password &amp; sign out)</a>
            <a class="primary-button" asp-controller="Account" asp-action="Run">Run launcher</a>
        </div>
    </div>
    <p class="muted">Hello, @displayName <span class="muted">(@((roles.Any() ? string.Join(", ", roles) : "User")))</span></p>

    <div class="account-tabs" role="tablist">
        <button type="button" class="account-tab @(activeTab == "jobs" ? "is-active" : null)" data-tab="jobs" role="tab" aria-selected="@(activeTab == "jobs" ? "true" : "false")">Jobs</button>
        <button type="button" class="account-tab @(activeTab == "repository" ? "is-active" : null)" data-tab="repository" role="tab" aria-selected="@(activeTab == "repository" ? "true" : "false")">Repository</button>
        <button type="button" class="account-tab @(activeTab == "worksource" ? "is-active" : null)" data-tab="worksource" role="tab" aria-selected="@(activeTab == "worksource" ? "true" : "false")">Work source</button>
        <button type="button" class="account-tab @(activeTab == "copilot" ? "is-active" : null)" data-tab="copilot" role="tab" aria-selected="@(activeTab == "copilot" ? "true" : "false")">Copilot settings</button>
        <button type="button" class="account-tab @(activeTab == "workflows" ? "is-active" : null)" data-tab="workflows" role="tab" aria-selected="@(activeTab == "workflows" ? "true" : "false")">Workflows</button>
        <button type="button" class="account-tab @(activeTab == "apikeys" ? "is-active" : null)" data-tab="apikeys" role="tab" aria-selected="@(activeTab == "apikeys" ? "true" : "false")">API keys</button>
    </div>

    @if (TempData["Message"] is string message)
    {
        <p class="muted">@message</p>
    }

    <form asp-action="Configuration" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <div id="account-tab-worksource" class="account-panel" @(activeTab == "worksource" ? null : "hidden")>
            <h2>Work source</h2>
            <p class="muted">Optional. Needed only when submitting ticket IDs; inline work items need no tracker.</p>
            <label>
                Work source
                <select asp-for="TrackerKind" id="tracker-kind">
                    <option value="none">None (inline work only)</option>
                    <option value="linear">Linear</option>
                    <option value="jira">Jira</option>
                </select>
            </label>
            <span asp-validation-for="TrackerKind" class="field-error"></span>

            <div data-tracker-kind="linear jira">
                <label>
                    <span id="tracker-endpoint-label">Tracker endpoint</span>
                    <input asp-for="TrackerEndpoint" autocomplete="off" />
                </label>
                <span asp-validation-for="TrackerEndpoint" class="field-error"></span>

                <label>
                    <span id="tracker-apikey-label">Tracker API key</span>
                    <input asp-for="TrackerApiKey" type="password" autocomplete="off" placeholder="Leave blank to keep" />
                </label>
                <span asp-validation-for="TrackerApiKey" class="field-error"></span>

                <label>
                    <span id="tracker-project-label">Project slug</span>
                    <input asp-for="TrackerProjectSlug" autocomplete="off" />
                </label>
                <span asp-validation-for="TrackerProjectSlug" class="field-error"></span>

                <label>
                    Active states (comma separated)
                    <input asp-for="TrackerActiveStates" autocomplete="off" />
                </label>
                <span asp-validation-for="TrackerActiveStates" class="field-error"></span>

                <label>
                    Terminal states (comma separated)
                    <input asp-for="TrackerTerminalStates" autocomplete="off" />
                </label>
                <span asp-validation-for="TrackerTerminalStates" class="field-error"></span>
            </div>

            </div>

        </div>
        <div id="account-tab-copilot" class="account-panel" @(activeTab == "copilot" ? null : "hidden")>
            <h2>Copilot BYOM</h2>
            <label>
                Provider
                <select asp-for="CopilotProvider" id="copilot-provider">
                    <option value="">(none)</option>
                    <option value="openai">OpenAI</option>
                    <option value="azure">Azure</option>
                    <option value="anthropic">Anthropic</option>
                </select>
            </label>
            <span asp-validation-for="CopilotProvider" class="field-error"></span>

            <div data-copilot-provider="openai azure anthropic">
                <label>
                    Base URL
                    <input asp-for="CopilotBaseUrl" autocomplete="off" />
                </label>
                <span asp-validation-for="CopilotBaseUrl" class="field-error"></span>

                <label>
                    Model ID
                    <input asp-for="CopilotModelId" autocomplete="off" />
                </label>
                <span asp-validation-for="CopilotModelId" class="field-error"></span>

                <label>
                    API key
                    <input asp-for="CopilotApiKey" type="password" autocomplete="off" placeholder="Leave blank to keep" />
                </label>
                <span asp-validation-for="CopilotApiKey" class="field-error"></span>
            </div>

            <div data-copilot-provider="openai" id="openai-wire-api">
                <label>
                    Wire API
                    <select asp-for="CopilotWireApi">
                        <option value="">(default)</option>
                        <option value="completions">completions</option>
                        <option value="responses">responses</option>
                    </select>
                </label>
                <span asp-validation-for="CopilotWireApi" class="field-error"></span>
            </div>

            <h2>Agent</h2>
            <label>
                Max concurrent agents
                <input asp-for="MaxConcurrentAgents" type="number" />
            </label>
            <span asp-validation-for="MaxConcurrentAgents" class="field-error"></span>

            <label>
                Max retry backoff (ms)
                <input asp-for="MaxRetryBackoffMs" type="number" />
            </label>
            <span asp-validation-for="MaxRetryBackoffMs" class="field-error"></span>

            <label>
                Max turns
                <input asp-for="MaxTurns" type="number" />
            </label>
            <span asp-validation-for="MaxTurns" class="field-error"></span>

            <label>
                Max concurrent agents by state
                <input asp-for="MaxConcurrentAgentsByState" autocomplete="off" />
            </label>
            <span asp-validation-for="MaxConcurrentAgentsByState" class="field-error"></span>

            </div>

        </div>
        <div id="account-tab-repository" class="account-panel" @(activeTab == "repository" ? null : "hidden")>
            <h2>GitHub personal access token</h2>
            <label>
                Personal access token
                <input asp-for="GitHubPersonalAccessToken" type="password" autocomplete="off" placeholder="Leave blank to keep" />
            </label>
            <span asp-validation-for="GitHubPersonalAccessToken" class="field-error"></span>

            <h2>Hooks</h2>
            <label>
                After create
                <textarea asp-for="HookAfterCreate" rows="3"></textarea>
            </label>
            <label>
                Before run
                <textarea asp-for="HookBeforeRun" rows="3"></textarea>
            </label>
            <label>
                After run
                <textarea asp-for="HookAfterRun" rows="3"></textarea>
            </label>
            <label>
                Before remove
                <textarea asp-for="HookBeforeRemove" rows="3"></textarea>
            </label>
            <label>
                Hook timeout (ms)
                <input asp-for="HookTimeoutMs" type="number" />
            </label>
            <span asp-validation-for="HookTimeoutMs" class="field-error"></span>
            </div>

            <button type="submit" id="save-configuration">Save configuration</button>
        </form>
    </div>

    <div id="account-tab-workflows" class="account-panel" @(activeTab == "workflows" ? null : "hidden")>
        <script>
            const workflowTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(workflowTemplate));
        </script>

        <section class="workflows-shell">
            <header class="workflows-header">
                <div>
                    <h1>Configured Workflows</h1>
                </div>
                <div class="workflow-toolbar" role="group" aria-label="Workflow actions">
                    <button type="button" id="new-workflow" class="primary-button">New</button>
                </div>
            </header>

            <div id="workflows-status" class="workflow-status" role="status" aria-live="polite"></div>

            <div id="workflow-empty" class="workflow-empty" hidden>No workflows yet. Click New to create one from the template.</div>

            <div class="table-panel">
                <table class="workflow-table" aria-label="Configured workflows">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Created</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody id="workflow-table-body"></tbody>
                </table>
            </div>
        </section>

    </div>

    <div id="account-tab-apikeys" class="account-panel" @(activeTab == "apikeys" ? null : "hidden")>
        @if (!string.IsNullOrEmpty(newKey))
        {
            <div id="new-key-banner">
                <strong>@(string.IsNullOrEmpty(newKeyName) ? "New API key" : newKeyName) — copy it now:</strong>
                <br />
                <code id="new-key-value" class="new-key-value">@newKey</code>
                <p class="muted">It will not be shown again. Rotate to get a new key if you lose it.</p>
            </div>
        }

        <h2>Create a key</h2>
        <form asp-action="CreateApiKey" method="post">
            @Html.AntiForgeryToken()
            <label>
                Key name (optional)
                <input name="name" maxlength="256" autocomplete="off" placeholder="e.g. laptop curl script" />
            </label>
            <button type="submit">Create API key</button>
        </form>

        <h2>Your keys</h2>
        @if (apiKeys.Count == 0)
        {
            <p class="muted">No API keys yet. Create one above to submit work from a terminal.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Prefix</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Last used</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in apiKeys)
                    {
                        var now = DateTimeOffset.UtcNow;
                        var revoked = key.RevokedAt is not null;
                        var expired = !revoked && key.ExpiresAt is not null && key.ExpiresAt <= now;
                        var active = key.IsEnabled && !revoked && !expired;
                        var restorable = key.ExpiresAt is null || key.ExpiresAt > now;
                        <tr>
                            <td>@(string.IsNullOrEmpty(key.Name) ? "—" : key.Name)</td>
                            <td><code>@key.KeyPrefix…</code></td>
                            <td>
                                @(revoked ? "Revoked" : expired ? "Expired" : active ? "Active" : "Disabled")
                                @if (key.ExpiresAt is { } expires)
                                {
                                    <br />
                                    <span class="muted">expires @expires.ToString("yyyy-MM-dd")</span>
                                }
                            </td>
                            <td>@key.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(key.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                            <td class="table-actions">
                                <form asp-action="RotateApiKey" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@key.Id" />
                                    <button type="submit">Rotate</button>
                                </form>
                                @if (restorable && !active)
                                {
                                    <form asp-action="SetApiKeyEnabled" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@key.Id" />
                                        <input type="hidden" name="enabled" value="true" />
                                        <button type="submit">Enable</button>
                                    </form>
                                }
                                @if (active)
                                {
                                    <form asp-action="SetApiKeyEnabled" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@key.Id" />
                                        <input type="hidden" name="enabled" value="false" />
                                        <button type="submit">Disable</button>
                                    </form>
                                    <form asp-action="RevokeApiKey" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@key.Id" />
                                        <button type="submit" class="danger-button">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div id="account-tab-jobs" class="account-panel" @(activeTab == "jobs" ? null : "hidden")>
        <h2>Active jobs</h2>
        <table class="workflow-table" aria-label="Active jobs">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Workflow</th>
                    <th>State</th>
                    <th>Queued</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="account-active-jobs"></tbody>
        </table>
        <p id="account-active-jobs-empty" class="muted">No active jobs.</p>

        <h2>Past jobs</h2>
        <table class="workflow-table" aria-label="Past jobs">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Workflow</th>
                    <th>State</th>
                    <th>Queued</th>
                    <th>Completed</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="account-past-jobs"></tbody>
        </table>
        <p id="account-past-jobs-empty" class="muted">No past jobs.</p>
    </div>
</section>

<dialog id="job-details-dialog">
    <h2>Job details</h2>
    <div id="job-details-body"></div>
    <div class="dialog-actions">
        <button type="button" onclick="this.closest('dialog').close()">Close</button>
    </div>
</dialog>

<script>
    window.activeAccountTab = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(activeTab));
</script>
<script>
(function () {
    function shortDate(value) {
        if (!value) return '—';
        try { return new Date(value).toLocaleString(); } catch (_) { return value; }
    }

    function isPastJobState(state) {
        const normalized = String(state || '').toLowerCase();
        return normalized === 'completed' || normalized === 'completedwithfailures' || normalized === 'failed' || normalized === 'cancelled' || normalized === 'canceled';
    }

    function renderJobs(jobs) {
        const activeBody = document.getElementById('account-active-jobs');
        const pastBody = document.getElementById('account-past-jobs');
        if (!activeBody || !pastBody) return;

        activeBody.innerHTML = '';
        pastBody.innerHTML = '';
        let activeCount = 0;
        let pastCount = 0;

        (jobs || []).forEach(function (job) {
            const row = document.createElement('tr');
            const jobId = document.createElement('td');
            jobId.textContent = String(job.externalId || job.id || '').slice(0, 8);
            const workflow = document.createElement('td');
            workflow.textContent = job.workflowName || '—';
            const state = document.createElement('td');
            state.textContent = job.state || '—';
            const queued = document.createElement('td');
            queued.textContent = shortDate(job.queuedAt);
            const statusCell = document.createElement('td');
            const viewButton = document.createElement('button');
            viewButton.type = 'button';
            viewButton.className = 'job-details-trigger';
            viewButton.textContent = 'View';
            viewButton.addEventListener('click', function () {
                openJobDetails(job.id);
            });
            statusCell.appendChild(viewButton);

            row.appendChild(jobId);
            row.appendChild(workflow);
            row.appendChild(state);
            row.appendChild(queued);

            if (isPastJobState(job.state)) {
                const completed = document.createElement('td');
                completed.textContent = shortDate(job.completedAt);
                row.appendChild(completed);
                row.appendChild(statusCell);
                pastBody.appendChild(row);
                pastCount++;
            } else {
                row.appendChild(statusCell);
                activeBody.appendChild(row);
                activeCount++;
            }
        });

        const activeEmpty = document.getElementById('account-active-jobs-empty');
        const pastEmpty = document.getElementById('account-past-jobs-empty');
        if (activeEmpty) activeEmpty.hidden = activeCount !== 0;
        if (pastEmpty) pastEmpty.hidden = pastCount !== 0;
    }

    async function openJobDetails(jobId) {
        const dialog = document.getElementById('job-details-dialog');
        const body = document.getElementById('job-details-body');
        body.replaceChildren();
        const oldRetry = dialog.querySelector('.job-retry-trigger');
        if (oldRetry) oldRetry.remove();
        const loading = document.createElement('p');
        loading.className = 'muted';
        loading.textContent = 'Loading job details…';
        body.appendChild(loading);
        dialog.showModal();

        try {
            const response = await fetch('/api/jobs/' + jobId, { credentials: 'same-origin' });
            if (!response.ok) throw new Error('Job not found.');
            const job = await response.json();
            body.replaceChildren();

            const grid = document.createElement('dl');
            grid.className = 'job-details-grid';

            function addDetail(label, value) {
                const dt = document.createElement('dt');
                dt.textContent = label;
                const dd = document.createElement('dd');
                dd.textContent = value === null || value === undefined || value === '' ? '—' : String(value);
                grid.appendChild(dt);
                grid.appendChild(dd);
            }

            addDetail('Job ID', job.id);
            addDetail('External ID', job.externalId);
            addDetail('Workflow', job.workflowName);
            addDetail('Repository', job.repository || (job.github && job.github.repository));
            addDetail('State', job.state);
            addDetail('Queued', shortDate(job.queuedAt));
            addDetail('Started', shortDate(job.startedAt));
            addDetail('Completed', shortDate(job.completedAt));
            addDetail('Issue count', job.issueCount);
            addDetail('Failed issues', job.failedIssueCount);
            if (job.error || job.errorMessage || job.errorCode) {
                addDetail('Error', job.errorMessage || job.error || job.errorCode);
            }
            if (job.summary) addDetail('Summary', job.summary);

            body.appendChild(grid);

            if (Array.isArray(job.issues) && job.issues.length > 0) {
                const heading = document.createElement('h3');
                heading.textContent = 'Issues';
                body.appendChild(heading);

                const table = document.createElement('table');
                table.className = 'workflow-table';
                const thead = document.createElement('thead');
                thead.innerHTML = '<tr><th>#</th><th>Identifier</th><th>Title</th><th>State</th><th>Result</th></tr>';
                const tbody = document.createElement('tbody');
                job.issues.forEach(function (issue, index) {
                    const row = document.createElement('tr');
                    const idCell = document.createElement('td');
                    idCell.textContent = index + 1;
                    const identifierCell = document.createElement('td');
                    identifierCell.textContent = issue.identifier || issue.id || '—';
                    const titleCell = document.createElement('td');
                    titleCell.textContent = issue.title || '—';
                    const stateCell = document.createElement('td');
                    stateCell.textContent = issue.state || '—';
                    const resultCell = document.createElement('td');
                    resultCell.textContent = issue.reason || issue.success === true ? 'OK' : (issue.success === false ? 'Failed' : '—');
                    row.appendChild(idCell);
                    row.appendChild(identifierCell);
                    row.appendChild(titleCell);
                    row.appendChild(stateCell);
                    row.appendChild(resultCell);
                    tbody.appendChild(row);
                });
                table.appendChild(thead);
                table.appendChild(tbody);
                body.appendChild(table);
            }

            const normalizedState = String(job.state || '').toLowerCase();
            if (normalizedState === 'failed' || normalizedState === 'completedwithfailures') {
                const actions = dialog.querySelector('.dialog-actions');
                const retryButton = document.createElement('button');
                retryButton.type = 'button';
                retryButton.className = 'primary-button job-retry-trigger';
                retryButton.textContent = 'Retry job';
                retryButton.addEventListener('click', async function () {
                    retryButton.disabled = true;
                    retryButton.textContent = 'Retrying…';
                    try {
                        const response = await fetch('/api/jobs/' + jobId + '/retry', {
                            method: 'POST',
                            credentials: 'same-origin'
                        });
                        if (!response.ok) {
                            const payload = await response.json().catch(function () { return {}; });
                            throw new Error((payload && (payload.error || payload.message)) || 'Retry failed.');
                        }
                        dialog.close();
                        loadJobs();
                    } catch (retryError) {
                        retryButton.disabled = false;
                        retryButton.textContent = 'Retry job';
                        window.alert(retryError.message || 'Retry failed.');
                    }
                });
                actions.insertBefore(retryButton, actions.firstChild);
            }
        } catch (error) {
            body.replaceChildren();
            const message = document.createElement('p');
            message.className = 'validation';
            message.textContent = 'Unable to load job details.';
            body.appendChild(message);
        }
    }

    async function loadJobs() {
        try {
            const response = await fetch('/api/jobs?pageSize=20', { credentials: 'same-origin' });
            if (!response.ok) return;
            const jobs = await response.json();
            const sortedJobs = Array.isArray(jobs) ? jobs.slice().sort(function (a, b) {
                return new Date(b.queuedAt || 0) - new Date(a.queuedAt || 0);
            }) : [];
            renderJobs(sortedJobs);
        } catch (_) {
        }
    }

    loadJobs();
    setInterval(loadJobs, 5000);
})();
</script>
<script>
    (function () {
        const tabs = document.querySelectorAll('.account-tab');
        const panels = {
            jobs: document.getElementById('account-tab-jobs'),
            worksource: document.getElementById('account-tab-worksource'),
            copilot: document.getElementById('account-tab-copilot'),
            repository: document.getElementById('account-tab-repository'),
            workflows: document.getElementById('account-tab-workflows'),
            apikeys: document.getElementById('account-tab-apikeys')
        };
        function activateTab(name) {
            if (!panels[name]) return;
            Object.keys(panels).forEach(function (key) {
                panels[key].hidden = key !== name;
            });
            tabs.forEach(function (tab) {
                const active = tab.getAttribute('data-tab') === name;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            const saveButton = document.getElementById('save-configuration');
            if (saveButton) {
                saveButton.hidden = ['worksource', 'copilot', 'repository'].indexOf(name) === -1;
            }
        }
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                activateTab(tab.getAttribute('data-tab'));
            });
        });
        activateTab(window.activeAccountTab || 'jobs');
    })();
</script>
<script>
    (function () {
        var provider = document.getElementById('copilot-provider');
        if (provider) {
            function updateCopilot() {
                var value = (provider.value || '').toLowerCase();
                document.querySelectorAll('[data-copilot-provider]').forEach(function (el) {
                    var providers = (el.getAttribute('data-copilot-provider') || '').split(/\s+/);
                    el.hidden = providers.indexOf(value) === -1;
                });
            }
            provider.addEventListener('change', updateCopilot);
            updateCopilot();
        }

        var tracker = document.getElementById('tracker-kind');
        if (tracker) {
            var endpointLabel = document.getElementById('tracker-endpoint-label');
            var apiKeyLabel = document.getElementById('tracker-apikey-label');
            var projectLabel = document.getElementById('tracker-project-label');
            function updateTracker() {
                var value = (tracker.value || '').toLowerCase();
                document.querySelectorAll('[data-tracker-kind]').forEach(function (el) {
                    var kinds = (el.getAttribute('data-tracker-kind') || '').split(/\s+/);
                    el.hidden = kinds.indexOf(value) === -1;
                });
                var endpointText = 'Tracker endpoint';
                var apiKeyText = 'Tracker API key';
                var projectText = 'Project slug';
                if (value === 'linear') {
                    endpointText = 'Linear Url';
                    apiKeyText = 'Linear API key';
                    projectText = 'Linear Project Slug';
                } else if (value === 'jira') {
                    endpointText = 'Jira Url';
                    apiKeyText = 'Jira API key';
                    projectText = 'Jira Project';
                }
                if (endpointLabel) endpointLabel.textContent = endpointText;
                if (apiKeyLabel) apiKeyLabel.textContent = apiKeyText;
                if (projectLabel) projectLabel.textContent = projectText;
            }
            tracker.addEventListener('change', updateTracker);
            updateTracker();
        }
    })();
</script>

<script>
(function () {
    const api = '/api/workflows';
    const status = document.getElementById('workflows-status');
    const empty = document.getElementById('workflow-empty');
    const tbody = document.getElementById('workflow-table-body');

    async function parseError(response) {
        try {
            const body = await response.json();
            return body && (body.error || body.title || body.message) || response.statusText;
        } catch {
            return response.statusText;
        }
    }

    function relativeTime(value) {
        if (!value) return 'unknown';
        const date = new Date(value);
        if (isNaN(date.getTime())) return String(value);
        const seconds = Math.round((Date.now() - date.getTime()) / 1000);
        const abs = Math.abs(seconds);
        if (abs < 60) return 'just now';
        if (abs < 3600) return Math.floor(abs / 60) + 'm ago';
        if (abs < 86400) return Math.floor(abs / 3600) + 'h ago';
        if (abs < 2592000) return Math.floor(abs / 86400) + 'd ago';
        if (abs < 31536000) return Math.floor(abs / 2592000) + 'mo ago';
        return Math.floor(abs / 31536000) + 'y ago';
    }

    async function loadWorkflows() {
        const response = await fetch(api, { credentials: 'same-origin' });
        if (!response.ok) {
            status.textContent = await parseError(response);
            status.classList.add('is-error');
            return;
        }

        const workflows = (await response.json())
            .sort((a, b) => String(a.name).localeCompare(String(b.name), undefined, { sensitivity: 'base' }));

        tbody.innerHTML = '';
        if (!workflows.length) {
            empty.hidden = false;
            return;
        }

        empty.hidden = true;
        workflows.forEach(item => {
            const row = document.createElement('tr');

            const nameCell = document.createElement('td');
            const link = document.createElement('a');
            link.href = '/Account/Workflows/Edit?name=' + encodeURIComponent(item.name);
            link.textContent = item.name + (item.isDefault ? ' (Default)' : '');
            link.className = 'workflow-link';
            nameCell.appendChild(link);

            const createdCell = document.createElement('td');
            createdCell.textContent = relativeTime(item.createdAt);

            const updatedCell = document.createElement('td');
            updatedCell.textContent = relativeTime(item.updatedAt);

            row.appendChild(nameCell);
            row.appendChild(createdCell);
            row.appendChild(updatedCell);
            tbody.appendChild(row);
        });
    }

    document.getElementById('new-workflow').addEventListener('click', async function () {
        const response = await fetch(api, { credentials: 'same-origin' });
        const existing = response.ok ? await response.json() : [];
        const names = new Set(existing.map(item => String(item.name).toLowerCase()));

        let name = 'New workflow';
        let suffix = 2;
        while (names.has(name.toLowerCase())) {
            name = 'New workflow ' + suffix;
            suffix += 1;
        }

        const createResponse = await fetch(api, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ name: name, content: workflowTemplate, isDefault: false })
        });

        if (!createResponse.ok) {
            status.textContent = await parseError(createResponse);
            status.classList.add('is-error');
            return;
        }

        const created = await createResponse.json();
        window.location.href = '/Account/Workflows/Edit?name=' + encodeURIComponent(created.name);
    });

    loadWorkflows();
})();
</script>
